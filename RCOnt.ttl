@prefix : <https://matinabtahi.github.io/OperationalDigitalTwinning/RCOnt#> .
@prefix rcont: <https://matinabtahi.github.io/OperationalDigitalTwinning/RCOnt#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix brick: <https://brickschema.org/schema/Brick#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix time: <http://www.w3.org/2006/time#> .
@prefix saref: <https://saref.etsi.org/core/> .

<https://matinabtahi.github.io/OperationalDigitalTwinning/RCOnt>
    a owl:Ontology ;
    rdfs:label "Resistance–Capacitance Ontology (RCOnt)"@en ;
    dcterms:title "Resistance–Capacitance Ontology (RCOnt)"@en ;
    dcterms:creator <https://orcid.org/0000-0003-3941-9485> ;
    dcterms:license <https://opensource.org/license/mit> ;
    dcterms:source <https://github.com/matinabtahi/Resistance-CapacitanceOntology> ;
    dcterms:modified "2026-09-06"^^xsd:date ;
    rdfs:comment "A lightweight OWL ontology for representing reduced-order resistance–capacitance thermal models used in operational building digital twins, including model structure, parameters, inputs, states, provenance, calibration, temporal validity and performance evaluation."@en ;
    owl:versionIRI <https://matinabtahi.github.io/OperationalDigitalTwinning/RCOnt/2.0.0> ;
    owl:priorVersion <https://matinabtahi.github.io/OperationalDigitalTwinning/RCOnt/1.0> ;
    owl:versionInfo "2.0.0" ;
    rdfs:seeAlso <https://github.com/matinabtahi/Resistance-CapacitanceOntology> .

rcont:RCModel a owl:Class ; rdfs:label "RC model"@en ; rdfs:comment "A reduced-order resistance–capacitance model describing the thermal dynamics of a building zone."@en .
rcont:Node a owl:Class ; rdfs:label "thermal node"@en ; rdfs:comment "A state node representing a thermodynamic mass or boundary condition in an RC model."@en .
rcont:AirNode a owl:Class ; rdfs:subClassOf rcont:Node ; rdfs:label "air node"@en .
rcont:EnvelopeNode a owl:Class ; rdfs:subClassOf rcont:Node ; rdfs:label "envelope node"@en .
rcont:BoundaryNode a owl:Class ; rdfs:subClassOf rcont:Node ; rdfs:label "boundary node"@en ; rdfs:comment "A node representing an external or prescribed thermal boundary, such as outdoor air."@en .
rcont:ThermalParameter a owl:Class ; rdfs:label "thermal parameter"@en .
rcont:ThermalResistance a owl:Class ; rdfs:subClassOf rcont:ThermalParameter ; rdfs:label "thermal resistance"@en .
rcont:ThermalCapacitance a owl:Class ; rdfs:subClassOf rcont:ThermalParameter ; rdfs:label "thermal capacitance"@en .
rcont:RValue a owl:Class ; owl:equivalentClass rcont:ThermalResistance ; rdfs:label "R value"@en ; rdfs:comment "Backward-compatible RCOnt class for a lumped thermal resistance."@en .
rcont:CValue a owl:Class ; owl:equivalentClass rcont:ThermalCapacitance ; rdfs:label "C value"@en ; rdfs:comment "Backward-compatible RCOnt class for a lumped thermal capacitance."@en .
rcont:SolarAperture a owl:Class ; rdfs:subClassOf rcont:ThermalParameter ; rdfs:label "solar aperture"@en ; rdfs:comment "An effective area that maps incident solar irradiance to a heat gain."@en .
rcont:Actuator a owl:Class ; rdfs:label "actuator"@en ; rdfs:comment "A controllable device or command signal that influences an RC model."@en .
rcont:Disturbance a owl:Class ; rdfs:label "disturbance"@en ; rdfs:comment "An exogenous influence on model dynamics that is not directly actuated."@en .
rcont:OccupancyLoad a owl:Class ; rdfs:subClassOf rcont:Disturbance ; rdfs:label "occupancy load"@en .
rcont:WeatherDisturbance a owl:Class ; rdfs:subClassOf rcont:Disturbance ; rdfs:label "weather disturbance"@en .
rcont:SimulationRun a owl:Class ; rdfs:subClassOf prov:Activity ; rdfs:label "simulation run"@en .
rcont:ParameterEstimation a owl:Class ; rdfs:subClassOf prov:Activity ; rdfs:label "parameter estimation"@en .
rcont:PerformanceMetric a owl:Class ; rdfs:label "performance metric"@en .
rcont:RMSE a owl:Class ; rdfs:subClassOf rcont:PerformanceMetric ; rdfs:label "root mean square error"@en .
rcont:EnergyUseError a owl:Class ; rdfs:subClassOf rcont:PerformanceMetric ; rdfs:label "energy-use error"@en .
rcont:ModelVersion a owl:Class ; rdfs:subClassOf prov:Entity ; rdfs:label "model version"@en .
rcont:ValidityInterval a owl:Class ; rdfs:subClassOf time:Interval ; rdfs:label "validity interval"@en .
rcont:hasNode a owl:ObjectProperty ; rdfs:domain rcont:RCModel ; rdfs:range rcont:Node ; rdfs:label "has node"@en .
rcont:isNodeOf a owl:ObjectProperty ; owl:inverseOf rcont:hasNode ; rdfs:domain rcont:Node ; rdfs:range rcont:RCModel ; rdfs:label "is node of"@en .
rcont:hasResistance a owl:ObjectProperty ; rdfs:domain rcont:RCModel ; rdfs:range rcont:ThermalResistance ; rdfs:label "has resistance"@en .
rcont:hasCapacitance a owl:ObjectProperty ; rdfs:domain rcont:RCModel ; rdfs:range rcont:ThermalCapacitance ; rdfs:label "has capacitance"@en .
rcont:hasSolarAperture a owl:ObjectProperty ; rdfs:domain rcont:RCModel ; rdfs:range rcont:SolarAperture ; rdfs:label "has solar aperture"@en .
rcont:connectsFrom a owl:ObjectProperty ; rdfs:domain rcont:ThermalResistance ; rdfs:range rcont:Node ; rdfs:label "connects from"@en ; rdfs:comment "Identifies one ordered endpoint of a resistance. Ordering is computational and does not imply physical asymmetry."@en .
rcont:connectsTo a owl:ObjectProperty ; rdfs:domain rcont:ThermalResistance ; rdfs:range rcont:Node ; rdfs:label "connects to"@en ; rdfs:comment "Identifies the other ordered endpoint of a resistance. Ordering is computational and does not imply physical asymmetry."@en .
rcont:connectsNode a owl:ObjectProperty ; rdfs:domain rcont:ThermalResistance ; rdfs:range rcont:Node ; rdfs:label "connects node"@en ; rdfs:comment "Undirected convenience relation for graph queries."@en .
rcont:connects a owl:ObjectProperty ; rdfs:subPropertyOf rcont:connectsNode ; rdfs:domain rcont:ThermalResistance ; rdfs:range rcont:Node ; rdfs:label "connects"@en ; owl:deprecated true ; rdfs:comment "Legacy v1 property retained for backward compatibility. New data should use connectsFrom/connectsTo."@en .
rcont:belongsToNode a owl:ObjectProperty ; rdfs:domain rcont:ThermalParameter ; rdfs:range rcont:Node ; rdfs:label "belongs to node"@en .
rcont:modelsZone a owl:ObjectProperty ; rdfs:domain rcont:RCModel ; rdfs:range brick:HVAC_Zone ; rdfs:label "models zone"@en .
rcont:hasInput a owl:ObjectProperty ; rdfs:domain rcont:RCModel ; rdfs:range brick:Point ; rdfs:label "has input"@en .
rcont:hasState a owl:ObjectProperty ; rdfs:domain rcont:RCModel ; rdfs:range brick:Point ; rdfs:label "has state"@en .
rcont:controlledBy a owl:ObjectProperty ; rdfs:domain rcont:RCModel ; rdfs:range rcont:Actuator ; rdfs:label "controlled by"@en .
rcont:actuates a owl:ObjectProperty ; owl:inverseOf rcont:controlledBy ; rdfs:domain rcont:Actuator ; rdfs:range rcont:RCModel ; rdfs:label "actuates"@en .
rcont:hasDisturbance a owl:ObjectProperty ; rdfs:domain rcont:RCModel ; rdfs:range rcont:Disturbance ; rdfs:label "has disturbance"@en .
rcont:simulatesModel a owl:ObjectProperty ; rdfs:domain rcont:SimulationRun ; rdfs:range rcont:RCModel ; rdfs:label "simulates model"@en .
rcont:producedMetric a owl:ObjectProperty ; rdfs:domain rcont:SimulationRun ; rdfs:range rcont:PerformanceMetric ; rdfs:label "produced metric"@en .
rcont:estimatesParameterOf a owl:ObjectProperty ; rdfs:domain rcont:ParameterEstimation ; rdfs:range rcont:RCModel ; rdfs:label "estimates parameter of"@en .
rcont:estimatedValue a owl:ObjectProperty ; rdfs:domain rcont:ParameterEstimation ; rdfs:range rcont:ThermalParameter ; rdfs:label "estimated value"@en .
rcont:usesMeasurement a owl:ObjectProperty ; rdfs:domain rcont:ParameterEstimation ; rdfs:range brick:Point ; rdfs:label "uses measurement"@en .
rcont:hasModelVersion a owl:ObjectProperty ; rdfs:domain rcont:RCModel ; rdfs:range rcont:ModelVersion ; rdfs:label "has model version"@en .
rcont:versionOfModel a owl:ObjectProperty ; owl:inverseOf rcont:hasModelVersion ; rdfs:domain rcont:ModelVersion ; rdfs:range rcont:RCModel ; rdfs:label "version of model"@en .
rcont:validDuring a owl:ObjectProperty ; rdfs:domain rcont:ModelVersion ; rdfs:range rcont:ValidityInterval ; rdfs:label "valid during"@en .
rcont:hasStartTime a owl:ObjectProperty ; rdfs:domain rcont:ValidityInterval ; rdfs:range time:Instant ; rdfs:label "has start time"@en .
rcont:hasEndTime a owl:ObjectProperty ; rdfs:domain rcont:ValidityInterval ; rdfs:range time:Instant ; rdfs:label "has end time"@en .
rcont:measuredBy a owl:ObjectProperty ; rdfs:domain [ a owl:Class ; owl:unionOf ( rcont:ThermalParameter rcont:PerformanceMetric ) ] ; rdfs:range prov:Activity ; rdfs:label "measured by"@en .
rcont:dataSource a owl:ObjectProperty ; rdfs:domain [ a owl:Class ; owl:unionOf ( rcont:ThermalParameter rcont:PerformanceMetric rcont:Disturbance ) ] ; rdfs:range prov:Entity ; rdfs:label "data source"@en .
rcont:numericValue a owl:DatatypeProperty ; rdfs:subPropertyOf qudt:numericValue ; rdfs:domain [ a owl:Class ; owl:unionOf ( rcont:ThermalParameter rcont:PerformanceMetric ) ] ; rdfs:range xsd:decimal ; rdfs:label "numeric value"@en .
rcont:unit a owl:ObjectProperty ; rdfs:subPropertyOf qudt:unit ; rdfs:domain [ a owl:Class ; owl:unionOf ( rcont:ThermalParameter rcont:PerformanceMetric rcont:Disturbance ) ] ; rdfs:range qudt:Unit ; rdfs:label "unit"@en .
rcont:uncertaintyStdDev a owl:DatatypeProperty ; rdfs:domain rcont:ThermalParameter ; rdfs:range xsd:decimal ; rdfs:label "uncertainty standard deviation"@en .
rcont:hasTimestep a owl:DatatypeProperty ; rdfs:domain rcont:SimulationRun ; rdfs:range xsd:decimal ; rdfs:label "has timestep"@en ; rdfs:comment "Simulation timestep in seconds."@en .
rcont:hasPredictionHorizon a owl:DatatypeProperty ; rdfs:domain rcont:SimulationRun ; rdfs:range xsd:decimal ; rdfs:label "has prediction horizon"@en ; rdfs:comment "Prediction horizon in seconds."@en .
rcont:governingEquation a owl:AnnotationProperty ; rdfs:label "governing equation"@en .
rcont:description a owl:AnnotationProperty ; rdfs:label "description"@en .
rcont:ThermalResistance rdfs:subClassOf [ a owl:Restriction ; owl:onProperty rcont:connectsFrom ; owl:cardinality "1"^^xsd:nonNegativeInteger ], [ a owl:Restriction ; owl:onProperty rcont:connectsTo ; owl:cardinality "1"^^xsd:nonNegativeInteger ], [ a owl:Restriction ; owl:onProperty rcont:numericValue ; owl:someValuesFrom xsd:decimal ], [ a owl:Restriction ; owl:onProperty rcont:unit ; owl:someValuesFrom qudt:Unit ] .
rcont:ThermalCapacitance rdfs:subClassOf [ a owl:Restriction ; owl:onProperty rcont:belongsToNode ; owl:cardinality "1"^^xsd:nonNegativeInteger ], [ a owl:Restriction ; owl:onProperty rcont:numericValue ; owl:someValuesFrom xsd:decimal ], [ a owl:Restriction ; owl:onProperty rcont:unit ; owl:someValuesFrom qudt:Unit ] .
rcont:SolarAperture rdfs:subClassOf [ a owl:Restriction ; owl:onProperty rcont:belongsToNode ; owl:cardinality "1"^^xsd:nonNegativeInteger ], [ a owl:Restriction ; owl:onProperty rcont:numericValue ; owl:someValuesFrom xsd:decimal ], [ a owl:Restriction ; owl:onProperty rcont:unit ; owl:someValuesFrom qudt:Unit ] .
rcont:RCModel rdfs:subClassOf [ a owl:Restriction ; owl:onProperty rcont:hasNode ; owl:minCardinality "1"^^xsd:nonNegativeInteger ], [ a owl:Restriction ; owl:onProperty rcont:modelsZone ; owl:maxCardinality "1"^^xsd:nonNegativeInteger ] .
rcont:Actuator rdfs:seeAlso brick:Command .
rcont:Disturbance rdfs:seeAlso saref:Property .
rcont:SimulationRun rdfs:seeAlso prov:Activity .
rcont:ModelVersion rdfs:seeAlso prov:Entity .
